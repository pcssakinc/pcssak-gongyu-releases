{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pcssakinc/pcssak-gongyu-releases/raw/main/latest.schema.json",
  "title": "PCssak Gongyu Tauri 정적 업데이트 매니페스트",
  "description": "Tauri Updater가 GitHub Releases의 Latest 자산에서 읽는 서명 검증용 정적 JSON",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "notes", "pub_date", "platforms"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^0\\.1\\.(?:[2-9]|[1-9][0-9]+)$"
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "pub_date": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows-x86_64"],
      "properties": {
        "windows-x86_64": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "signature"],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://github\\.com/pcssakinc/pcssak-gongyu-releases/releases/download/(?:v0\\.1\\.2/PCssak-Gongyu-Beta-Windows-x64-Setup\\.exe|v(0\\.1\\.(?:[3-9]|[1-9][0-9]+))/PCssak-Gongyu-\\1-Windows-x64-Setup\\.exe)$"
            },
            "signature": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]+={0,2}$",
              "minLength": 80,
              "maxLength": 16384
            }
          }
        }
      }
    }
  }
}
